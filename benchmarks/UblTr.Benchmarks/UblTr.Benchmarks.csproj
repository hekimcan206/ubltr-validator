  <ItemGroup>
    <ProjectReference Include="..\..\src\UblTr.Validator\UblTr.Validator.csproj" />
    <ProjectReference Include="..\..\tools\UblTr.SampleGen\UblTr.SampleGen.csproj" />
  </ItemGroup>

</Project>
