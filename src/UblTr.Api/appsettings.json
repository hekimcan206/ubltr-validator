{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.Hosting.Lifetime": "Information"
      }
    }
  },
  "AllowedHosts": "*",
  "Validation": {
    "MaxDocumentBytes": 20971520,
    "MaxConcurrentValidations": 0,
    "QueueLimit": 64,
    "GibDirectory": ""
  },
  "OpenApi": {
    "Enabled": true
  }
}
